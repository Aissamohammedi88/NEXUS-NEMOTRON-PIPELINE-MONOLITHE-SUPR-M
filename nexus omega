# ═══════════════════════════════════════════════════════════════════════════
# SECTION 9 : NETTOYAGE ET SÉCURITÉ
# ═══════════════════════════════════════════════════════════════════════════
cleanup_old_files() {
    logi "Nettoyage des anciens fichiers temporaires..."
    rm -f /tmp/nexus_chat_out.txt /tmp/nexus_omega_ui.log 2>/dev/null
    logs "Nettoyage terminé."
}

# ═══════════════════════════════════════════════════════════════════════════
# SECTION 10 : EXÉCUTION PRINCIPALE
# ═══════════════════════════════════════════════════════════════════════════
main() {
    clear
    echo -e "${M}╔══════════════════════════════════════════════════════════════╗${N}"
    echo -e "${M}║       NEXUS VORTEX OMEGA ENGINE - INSTALLATION               ║${N}"
    echo -e "${M}╚══════════════════════════════════════════════════════════════╝${N}"
    echo -e "${Y}Ce script va installer un modèle d'IA local (2.4 Go) et son interface.${N}\n"

    check_dependencies
    setup_directories
    setup_venv
    download_model
    generate_backend
    generate_frontend
    create_desktop_entry
    cleanup_old_files

    echo -e "\n${G}╔══════════════════════════════════════════════════════════════╗${N}"
    echo -e "${G}║   [✓] INSTALLATION RÉUSSIE                                  ║${N}"
    echo -e "${G}╚══════════════════════════════════════════════════════════════╝${N}"
    echo -e "${C}Pour lancer ton IA, tape : ${Y}$HOME_DIR/frontend.sh${N}"
    echo -e "${C}Ou cherche 'Nexus Vortex Omega' dans ton menu Cinnamon.${N}\n"
}

main "$@"
